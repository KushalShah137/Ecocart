# EcoCart environment configuration — copy to .env and fill in real values.
# Never commit .env.

# Oracle Database XE 21c, pluggable database XEPDB1 (change DSN if using 23ai/26ai Free) (python-oracledb thin mode, no Instant Client needed)
ECOCART_DB_USER=ecocart
ECOCART_DB_PASSWORD=aman
ECOCART_DB_DSN=localhost:1521/XEPDB1
ECOCART_DB_POOL_MIN=1
ECOCART_DB_POOL_MAX=4

# Flask
FLASK_SECRET_KEY=generate-a-long-random-string
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
SESSION_HOURS=12
SESSION_COOKIE_SECURE=false   # set true when served over HTTPS

# Business rules
ECO_SWAP_PRICE_TOLERANCE=0.20  # ±20 % price window for Eco Swap
ECO_SWAP_MAX_RESULTS=4
SHOP_PAGE_SIZE=12
